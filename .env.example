# Copia este archivo como .env y completa los valores. El .env no se sube (.gitignore).
# Generar SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ---
SECRET_KEY=pega-aqui-tu-clave-generada
DEBUG=True                       # produccion: False
ALLOWED_HOSTS=127.0.0.1,localhost   # produccion: tu-dominio.com

# --- Base de datos ---
DB_ENGINE=mssql
DB_NAME=GourmetDB
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Local: auth de Windows (dejar USER/PASSWORD vacios).
# Produccion: DB_TRUSTED_CONNECTION=no y completar USER/PASSWORD.
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=
